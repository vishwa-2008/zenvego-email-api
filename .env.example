# ─── Zenvego Email OTP Backend ───
# SMTP Configuration (TLS port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ─── MongoDB Connection ───
# Local MongoDB default:
MONGODB_URI=mongodb://localhost:27017
# Free-tier MongoDB Atlas example (uncomment and fill in):
# MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/zenvego?retryWrites=true&w=majority

# ─── HTTP Server ───
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
